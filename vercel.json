{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/how-it-works", "destination": "/#journey", "permanent": true },
    { "source": "/the-experience", "destination": "/#journey", "permanent": true },
    { "source": "/our-story", "destination": "/our-story-between-two-worlds", "permanent": true },
    { "source": "/why-the-philippines", "destination": "/medical-travel-philippines", "permanent": true },
    { "source": "/vision-care", "destination": "/areas-of-care", "permanent": true },
    { "source": "/fetility-reproductive-care", "destination": "/fertility-reproductive-care", "permanent": true },
    { "source": "/orthopedic-care", "destination": "/areas-of-care", "permanent": true },
    { "source": "/cardiology-advanced-heart-care", "destination": "/areas-of-care", "permanent": true },
    { "source": "/preventive-care-diagnostics", "destination": "/areas-of-care", "permanent": true },
    { "source": "/healthy-aging-geriatric-care", "destination": "/areas-of-care", "permanent": true },
    { "source": "/private-nursing-caregiver-support", "destination": "/areas-of-care", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
