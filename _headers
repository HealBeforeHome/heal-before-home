# Cloudflare reads this file; netlify.toml and vercel.json are legacy and are
# never consulted by the current deploy (see wrangler.jsonc).
#
# Caching note: there is no build step here, so nothing is content-hashed and
# rebuild-images.py rewrites photographs UNDER THEIR EXISTING NAME. That rules
# out `immutable` for anything that can be re-edited - a replaced photo would be
# stranded in caches for a year with no way to bust it. Only the fonts, whose
# bytes are fixed for the life of the filename, get the long treatment.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# A day of silence, then a week of serve-stale-while-refreshing. A replaced
# photograph reaches returning visitors within about a day.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Edited far more often than the images and they carry the whole layout, so the
# window is short; stale-while-revalidate keeps repeat views instant regardless.
/assets/css/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

# HTML deliberately has no Cache-Control here: Cloudflare's default for static
# assets already revalidates every time, which is what these pages want.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
