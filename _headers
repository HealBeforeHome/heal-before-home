# Cloudflare reads this file on deploy (see wrangler.jsonc).
#
# Caching note: there is no build step here, so nothing is content-hashed and
# rebuild-images.py rewrites photographs UNDER THEIR EXISTING NAME. That rules
# out `immutable` for anything that can be re-edited - a replaced photo would be
# stranded in caches for a year with no way to bust it. Only the fonts, whose
# bytes are fixed for the life of the filename, get the long treatment.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# A day of silence, then a week of serve-stale-while-refreshing. A replaced
# photograph reaches returning visitors within about a day.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Edited far more often than the images and they carry the whole layout, so the
# window is short; stale-while-revalidate keeps repeat views instant regardless.
/assets/css/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

# HTML deliberately has no Cache-Control here: Cloudflare's default for static
# assets already revalidates every time, which is what these pages want.
# Security headers. X-Frame-Options is DENY - the site embeds no iframes of its
# own, so nothing needs to frame it.
#
# HSTS is deliberately without includeSubDomains and without preload: the first
# would break any subdomain still served over HTTP, the second is effectively
# irreversible. Add includeSubDomains once every subdomain is confirmed HTTPS.
#
# CSP: everything is first-party except Cloudflare Turnstile (its script and the
# challenge iframe, both on challenges.cloudflare.com) and Google Analytics 4,
# so the policy is tight. GA is loaded by assets/js/analytics.js only after the
# visitor accepts the cookie banner; its hosts (gtag.js on googletagmanager.com,
# hits to *.google-analytics.com / *.analytics.google.com) are the only other
# entries in script-src, img-src and connect-src. Form submissions go to the
# site's own /api/submit, which forwards to HubSpot server-side. Two deliberate concessions:
#   - style-src needs 'unsafe-inline' for the ~200 inline style="" attributes and
#     site.js's el.style.setProperty for --reveal-delay.
#   - form-action 'none' is intentional. No form here submits natively; every one
#     goes out through fetch(), which connect-src governs. This blocks the
#     browser's default GET fallback that would otherwise put enquiry field
#     values into the URL if hubspot-forms.js ever failed to load.
#
# The script-src hash covers the one inline <script> in every page (identical on
# all of them). EDIT THAT SNIPPET AND THE SITE BREAKS until this hash is recomputed -
# CSP would block the very failsafe that reveals the content. To recompute:
#   python -c "import re,hashlib,base64;s=re.search(rb'<script>(.*?)</script>',open('index.html','rb').read(),re.S).group(1);print('sha256-'+base64.b64encode(hashlib.sha256(s).digest()).decode())"
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), autoplay=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-67F3+sihOvmHhP28srzYcny0qh3HqnWxeWkNMAhKNgY=' https://challenges.cloudflare.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://challenges.cloudflare.com; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
